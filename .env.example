# Copy to .env and fill in. See docs/setup.md for the full walkthrough.
# Never commit the real .env -- it's gitignored.

# --- Chatwoot core (Rails) ------------------------------------------------
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=
FRONTEND_URL=http://localhost:3000
POSTGRES_PASSWORD=chatwoot
POSTGRES_DATABASE=chatwoot
REDIS_PASSWORD=

# --- Chatwoot API access ---------------------------------------------------
# Set after the first-run setup wizard (docs/setup.md step 3): Profile settings > Access Token.
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_ACCESS_TOKEN=

# --- mcp-server -------------------------------------------------------------
# In Docker Compose this is the Chatwoot service's internal address, not localhost.
MCP_CHATWOOT_BASE_URL=http://chatwoot:3000
MCP_CHATWOOT_ACCOUNT_ID=1
MCP_CHATWOOT_API_ACCESS_TOKEN=
# Shared secret ai-service presents as a Bearer token over the HTTP transport. Generate with:
# openssl rand -hex 32
MCP_AUTH_TOKEN=
# false = read-only tools only; tag/attribute/note writes are refused.
MCP_ENABLE_MUTATIONS=true
# stdio is the package default for local ad-hoc tool inspection; the mcp-server Dockerfile
# overrides this to streamable-http, which is what Docker Compose and any cloud deployment
# actually use (see docs/mcp-server.md).
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8100
MCP_LOG_LEVEL=INFO

# --- rag-mcp (docs/adr/0006) ---------------------------------------------------
# Semantic search over knowledge-base/ -- pgvector in its own schema of the same Postgres
# instance, local zero-cost embeddings (fastembed). No external API/vendor. Unlike Jira/Azure
# DevOps grounding, this is on by default in docker-compose (ai-service's RAG_MCP_URL points at
# it directly) since it's a local, always-available, zero-cost part of the same stack -- it
# still degrades gracefully to the flat knowledge-base dump if this service is ever down.
# Shared secret ai-service presents as a Bearer token over the HTTP transport. Generate with:
# openssl rand -hex 32
RAG_AUTH_TOKEN=
RAG_TOP_K=3

# Ingestion UI for QA/CS staff at /ui (docs/adr/0007) -- separate credential from RAG_AUTH_TOKEN
# above (HTTP Basic, not Bearer). Server refuses to serve /ui if RAG_UI_PASSWORD is unset.
RAG_UI_USERNAME=admin
RAG_UI_PASSWORD=

# --- ai-service ---------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Include the /mcp path -- that's where fastmcp's Streamable HTTP transport is mounted.
MCP_SERVER_URL=http://mcp-server:8100/mcp
# Same value as MCP_AUTH_TOKEN above -- ai-service is the client presenting it.
AI_WEBHOOK_SHARED_SECRET=
# Configuration-driven category list (brief 3.B) -- add/remove without touching code.
SUPPORT_CATEGORIES=Bug,Crash,Technical,Installation,Account,Performance,Billing,Feature Request,Feedback,Other
LOG_LEVEL=INFO

# --- Issue-tracker grounding (docs/adr/0004, optional, independent per source) -----
# Real Jira/Azure DevOps search results are folded into the classification prompt alongside the
# static knowledge-base excerpt. Leave a *_MCP_URL blank to skip that source entirely.
# Jira: Atlassian's official remote MCP server (github.com/atlassian/atlassian-mcp-server),
# typically https://mcp.atlassian.com/v1/mcp -- API token auth must be enabled by an org admin
# for headless/non-interactive use.
JIRA_MCP_URL=
JIRA_MCP_API_TOKEN=
# Prepended to the search JQL, e.g. "project = SUPPORT"
JIRA_JQL_PROJECT_FILTER=
# Azure DevOps: Microsoft's official MCP server (github.com/microsoft/azure-devops-mcp), run
# locally/self-hosted or via their remote onboarding -- PAT-based auth.
AZURE_DEVOPS_MCP_URL=
AZURE_DEVOPS_MCP_PAT=
GROUNDING_MAX_RESULTS=3

# --- Postgres backups (docs/setup.md#backups) ---------------------------------
# Optional: leave S3_BUCKET blank and the backup service logs a message and does nothing.
# Works with AWS S3 or any S3-compatible provider (MinIO, Backblaze B2, DigitalOcean Spaces,
# Cloudflare R2).
S3_BUCKET=
S3_REGION=us-east-1
# Only needed for non-AWS S3-compatible providers, e.g. http://minio:9000
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BACKUP_PREFIX=chatwoot-backups
# How long to keep backups before the backup job prunes them. 0 disables pruning.
BACKUP_RETENTION_DAYS=14
# Standard 5-field cron syntax, evaluated on the container's UTC clock.
BACKUP_CRON_SCHEDULE=0 3 * * *

# --- Cloud deployment, Path A only (docs/setup.md) -----------------------------
# Public hostname Caddy requests a certificate for. Leave blank for local dev.
DOMAIN=
